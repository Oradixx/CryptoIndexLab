{
  "name": "CryptoIndexLab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2
  },
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "CryptoIndexLab",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "docker compose up --build -d"
}
