# Frontend
FRONTEND_PORT=3000
FRONTEND_PUBLIC_API1_URL=http://localhost:8001
FRONTEND_PUBLIC_API2_URL=http://localhost:8002

# API1 - Users/Auth Service
API1_PORT=8001
API1_LOG_LEVEL=info
API1_JWT_SECRET=change_me_for_dev_only
API1_TOKEN_TTL_SECONDS=3600
API1_DATABASE_URL=postgresql+psycopg2://crypto_user:crypto_pass@db1:5432/crypto_auth

# API2 - Crypto Index Service
API2_PORT=8002
API2_LOG_LEVEL=info
API2_DATABASE_URL=postgresql+psycopg2://crypto_user:crypto_pass@db2:5432/crypto_index
API2_MARKET_DATA_BASE_URL=https://api.coingecko.com/api/v3
API2_MARKET_DATA_TIMEOUT_SECONDS=10
API2_MARKET_DATA_CURRENCY=usd
API2_MARKET_DATA_DAYS=365
API2_MARKET_DATA_CACHE_TTL_SECONDS=300
# Optional for higher CoinGecko limits
API2_MARKET_DATA_API_KEY=

# DB1 - API1 database
DB1_NAME=crypto_auth
DB1_USER=crypto_user
DB1_PASSWORD=crypto_pass

# DB2 - API2 database
DB2_NAME=crypto_index
DB2_USER=crypto_user
DB2_PASSWORD=crypto_pass
