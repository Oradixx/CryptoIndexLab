# Frontend
FRONTEND_PORT=3000
# Browser-facing API URLs used by frontend runtime config
# Defaults are proxied through frontend nginx to avoid CORS setup.
FRONTEND_PUBLIC_API1_URL=/api1
FRONTEND_PUBLIC_API2_URL=/api2

# API1 - Users/Auth Service
API1_PORT=8001
API1_LOG_LEVEL=info
API1_JWT_SECRET=change_me_for_dev_only
API1_TOKEN_TTL_SECONDS=3600
API1_DATABASE_URL=postgresql+psycopg2://crypto_user:crypto_pass@db1:5432/crypto_auth
API1_DB_INIT_MAX_ATTEMPTS=10
API1_DB_INIT_RETRY_DELAY_SECONDS=2

# API2 - Crypto Index Service
API2_PORT=8002
API2_LOG_LEVEL=info
API2_DATABASE_URL=postgresql+psycopg2://crypto_user:crypto_pass@db2:5432/crypto_index
API2_DB_INIT_MAX_ATTEMPTS=10
API2_DB_INIT_RETRY_DELAY_SECONDS=2
API2_MARKET_DATA_BASE_URL=https://api.coingecko.com/api/v3
API2_MARKET_DATA_TIMEOUT_SECONDS=10
API2_MARKET_DATA_CURRENCY=usd
API2_MARKET_DATA_DAYS=365
API2_MARKET_DATA_CACHE_TTL_SECONDS=300
# Optional for higher CoinGecko limits
API2_MARKET_DATA_API_KEY=
API2_AUTH_API1_ME_URL=http://api1:8001/me
API2_AUTH_TIMEOUT_SECONDS=5

# DB1 - API1 database
DB1_NAME=crypto_auth
DB1_USER=crypto_user
DB1_PASSWORD=crypto_pass

# DB2 - API2 database
DB2_NAME=crypto_index
DB2_USER=crypto_user
DB2_PASSWORD=crypto_pass

# Notes:
# - Inside Docker, services use internal hostnames (api1, api2, db1, db2), not localhost.
# - FRONTEND_PUBLIC_API1_URL / FRONTEND_PUBLIC_API2_URL are browser-facing URLs (proxied by frontend nginx by default).
